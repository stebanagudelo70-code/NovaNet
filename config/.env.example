# ============================================
# novaNet - Variables de Entorno (plantilla)
# ============================================
# Copia este archivo como config/.env y completa cada campo con TUS datos.
# El archivo .env real NO se sube a GitHub (esta ignorado en .gitignore).

# Clave API de OpenRouter LLM (obtenla en https://openrouter.ai)
# -> Aqui va tu OPENROUTER_API_KEY personal
OPENROUTER_API_KEY=tu_api_key_aqui

# Configuracion de base de datos PostgreSQL
# -> Aqui va el host de tu PostgreSQL (por defecto: localhost)
DB_HOST=localhost
# -> Aqui va el nombre de tu base de datos (por defecto: clientes_internet)
DB_NAME=clientes_internet
# -> Aqui va tu usuario de PostgreSQL (por defecto: postgres)
DB_USER=tu_usuario_db
# -> Aqui va la contrasena de tu usuario de PostgreSQL
DB_PASSWORD=tu_password_db
# -> Aqui va el puerto de PostgreSQL (por defecto: 5432)
DB_PORT=5432
